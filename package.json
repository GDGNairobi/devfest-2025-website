{
  "name": "devfest-nairobi-2025",
  "version": "1.0.0",
  "description": "Official website for DevFest Nairobi 2025 - A modern, mobile-first conference website built with Qwik, Tailwind CSS, and Sanity CMS",
  "keywords": [
    "devfest",
    "gdg",
    "nairobi",
    "conference",
    "qwik",
    "tailwind",
    "sanity",
    "kenya",
    "africa",
    "google-developers"
  ],
  "homepage": "https://devfestnairobi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GDGNairobi/devfest-2025-website.git"
  },
  "bugs": {
    "url": "https://github.com/GDGNairobi/devfest-2025-website/issues"
  },
  "author": "GDG Nairobi",
  "license": "MIT",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "seed:schedule": "tsx scripts/seed-schedule.ts",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.17.1",
    "@builder.io/qwik-city": "^1.17.1",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "20.19.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.17.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.6",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.1.11",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "dependencies": {
    "@sanity/client": "^7.12.0"
  }
}