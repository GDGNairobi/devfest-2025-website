# Sanity CMS Configuration
# Get these values from your Sanity project dashboard at https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=your-project-id-here
PUBLIC_SANITY_DATASET=production

# Sanity Write Token (required for seeding data)
# Generate a token with Editor or Admin permissions at:
# https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens
SANITY_WRITE_TOKEN=your-write-token-here
